  "components": [
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The single dashboard container: title, interpretive sentence, then evidence.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Este mes en tu cartera</h2><p class=\"ds-panel-frase\">Te quedó el <b class=\"ds-pos\">63,4%</b> de lo que entró.</p><div class=\"ds-row\"><span>Entró</span><span class=\"ds-in\">+$6.500.000</span></div><div class=\"ds-row\"><span>Salió</span><span class=\"ds-out\">−$1.527.000</span></div><div class=\"ds-total\"><span>Te quedó</span><span>$4.973.000</span></div></section>",
      "css": ".ds-panel{font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;background:var(--card,#fff);color:var(--foreground,#0f172a);border:1px solid var(--border,#e2e8f0);border-radius:14px;padding:20px;max-width:360px}.ds-panel-title{margin:0 0 12px;font-size:14px;font-weight:600;color:var(--muted-foreground,#5b6b80)}.ds-panel-frase{margin:0 0 16px;font-size:15px;line-height:1.375}.ds-pos{font-weight:600;color:var(--inversiones-text,#15803d)}.ds-row{display:flex;justify-content:space-between;font-size:15px;margin-top:4px}.ds-in{font-weight:500;color:var(--cartera,#2563eb)}.ds-out{font-weight:500;color:var(--deudas,#dc2626)}.ds-total{display:flex;justify-content:space-between;margin-top:12px;padding-top:8px;border-top:2px solid color-mix(in oklab,var(--foreground,#0f172a) 80%,transparent);font-size:15px;font-weight:600}"
    },
    {
      "name": "Segmented control",
      "kind": "chip",
      "refersTo": "segmented",
      "description": "Single-choice period or series picker on a Wash track.",
      "html": "<div class=\"ds-seg\" role=\"group\" aria-label=\"Período\"><button class=\"ds-seg-item\">3M</button><button class=\"ds-seg-item ds-on\" aria-pressed=\"true\">6M</button><button class=\"ds-seg-item\">1A</button><button class=\"ds-seg-item\">Todo</button></div>",
      "css": ".ds-seg{font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;display:inline-flex;gap:2px;padding:2px;border-radius:8px;background:var(--muted,#f1f5f9)}.ds-seg-item{height:28px;padding:0 8px;border:0;border-radius:6px;background:transparent;font:inherit;font-size:12px;font-weight:500;color:var(--muted-foreground,#5b6b80);cursor:pointer;transition:color .15s}.ds-seg-item:hover{color:var(--foreground,#0f172a)}.ds-seg-item:focus-visible{outline:2px solid var(--ring,#94a3b8);outline-offset:2px}.ds-seg-item.ds-on{background:var(--card,#fff);color:var(--foreground,#0f172a);box-shadow:0 1px 2px 0 rgb(0 0 0/.05)}"
    },
    {
      "name": "Nav pills",
      "kind": "nav",
      "refersTo": "nav-pill",
      "description": "Desktop header navigation; active pill filled with Ink.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-pill ds-active\" aria-current=\"page\">Dashboard</button><button class=\"ds-pill\">Transacciones</button><button class=\"ds-pill\">Inversiones<span class=\"ds-dot\"></span></button></nav>",
      "css": ".ds-nav{font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;display:flex;gap:4px}.ds-pill{display:flex;align-items:center;padding:6px 12px;border:0;border-radius:9999px;background:transparent;font:inherit;font-size:14px;color:var(--muted-foreground,#5b6b80);cursor:pointer;transition:background .15s,color .15s}.ds-pill:hover{background:var(--muted,#f1f5f9);color:var(--foreground,#0f172a)}.ds-pill:focus-visible{outline:2px solid var(--ring,#94a3b8);outline-offset:2px}.ds-pill.ds-active{background:var(--primary,#0f172a);color:var(--primary-foreground,#f6f8fa);font-weight:500}.ds-dot{width:6px;height:6px;margin-left:6px;transform:translateY(-8px);border-radius:9999px;background:var(--alerta,#d97706)}"
    },
    {
      "name": "Confirm and skip buttons",
      "kind": "button",
      "refersTo": "button-confirm",
      "description": "32px icon pair on upcoming rows: quiet skip, Ink-filled register.",
      "html": "<div class=\"ds-pair\"><button class=\"ds-quiet\" aria-label=\"No tomar esta vez\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button><button class=\"ds-confirm\" aria-label=\"Registrar\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></button></div>",
      "css": ".ds-pair{display:flex;gap:4px}.ds-quiet,.ds-confirm{display:grid;place-items:center;width:32px;height:32px;border:0;border-radius:8px;cursor:pointer}.ds-quiet{background:transparent;color:var(--muted-foreground,#5b6b80);transition:background .15s,color .15s}.ds-quiet:hover{background:var(--muted,#f1f5f9);color:var(--deudas,#dc2626)}.ds-confirm{background:var(--primary,#0f172a);color:var(--primary-foreground,#f6f8fa);transition:opacity .15s}.ds-confirm:hover{opacity:.85}.ds-quiet:focus-visible,.ds-confirm:focus-visible{outline:2px solid var(--ring,#94a3b8);outline-offset:2px}"
    },
    {
      "name": "Category bars with sum",
      "kind": "custom",
      "refersTo": "bar-track",
      "description": "Spending by category in Ink bars, closed by the adding-machine total.",
      "html": "<div class=\"ds-cats\"><p class=\"ds-frase\"><b>Arriendo</b> se lleva el <b>39%</b> de lo que gastaste en el último mes.</p><div class=\"ds-cat\"><span>Arriendo</span><span class=\"ds-track\"><span style=\"width:100%\"></span></span><b>$1,2M</b></div><div class=\"ds-cat\"><span>Mercado</span><span class=\"ds-track\"><span style=\"width:61%\"></span></span><b>$729k</b></div><div class=\"ds-cat\"><span>Ocio</span><span class=\"ds-track\"><span style=\"width:41%\"></span></span><b>$488k</b></div><div class=\"ds-sum\"><span>Total gastado, con tarjetas</span><span>$2.978.000</span></div></div>",
      "css": ".ds-cats{font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;max-width:420px;color:var(--foreground,#0f172a)}.ds-frase{margin:0 0 16px;font-size:15px;line-height:1.375}.ds-frase b{font-weight:600}.ds-cat{display:grid;grid-template-columns:7.5rem 1fr 4rem;align-items:center;gap:12px;padding:6px 8px;margin:0 -8px;border-radius:8px;font-size:14px;cursor:pointer;transition:background .15s}.ds-cat:hover{background:var(--muted,#f1f5f9)}.ds-cat b{text-align:right;font-weight:600}.ds-track{display:block;height:8px;border-radius:9999px;background:var(--muted,#f1f5f9);overflow:hidden}.ds-track span{display:block;height:100%;border-radius:9999px;background:color-mix(in oklab,var(--foreground,#0f172a) 75%,transparent)}.ds-sum{display:flex;justify-content:space-between;margin-top:12px;padding-top:8px;border-top:2px solid color-mix(in oklab,var(--foreground,#0f172a) 80%,transparent);font-size:15px;font-weight:600}"
    },
    {
      "name": "Composition strip",
      "kind": "custom",
      "refersTo": "composition-bar",
      "description": "Patrimonio figure, four-domain stacked bar and labeled legend.",
      "html": "<div class=\"ds-comp\"><div class=\"ds-head\"><span class=\"ds-t\">Patrimonio</span><span class=\"ds-big\">$319,1M</span></div><div class=\"ds-strip\"><span style=\"flex-grow:287;background:var(--activos,#d4961c)\"></span><span style=\"flex-grow:20;background:var(--inversiones,#16a34a)\"></span><span style=\"flex-grow:27;background:var(--cartera,#2563eb)\"></span><span style=\"flex-grow:15;background:var(--deudas,#dc2626)\"></span></div><ul class=\"ds-leg\"><li><i style=\"background:var(--activos,#d4961c)\"></i>Activos<b style=\"color:var(--activos-text,#a16207)\">$287,0M</b></li><li><i style=\"background:var(--deudas,#dc2626)\"></i>Deudas<b style=\"color:var(--deudas,#dc2626)\">−$15,3M</b></li></ul></div>",
      "css": ".ds-comp{font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--foreground,#0f172a);max-width:520px}.ds-head{display:flex;align-items:baseline;gap:16px}.ds-t{font-size:14px;font-weight:600;color:var(--muted-foreground,#5b6b80)}.ds-big{font-size:36px;font-weight:600;letter-spacing:-.025em}.ds-strip{display:flex;gap:2px;height:12px;margin-top:16px;border-radius:9999px;overflow:hidden;background:var(--muted,#f1f5f9)}.ds-strip span{flex-basis:0}.ds-leg{display:grid;grid-template-columns:1fr 1fr;gap:12px 24px;margin:12px 0 0;padding:0;list-style:none;font-size:13px;color:var(--muted-foreground,#5b6b80)}.ds-leg i{display:inline-block;width:8px;height:8px;margin-right:6px;border-radius:2px}.ds-leg b{display:block;margin-top:2px;font-size:18px;font-weight:600}"
    },
    {
      "name": "FAB",
      "kind": "button",
      "refersTo": "fab",
      "description": "Mobile-only create action, Ink circle with the floating shadow.",
      "html": "<button class=\"ds-fab\" aria-label=\"Agregar\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-fab{display:grid;place-items:center;width:56px;height:56px;border:0;border-radius:9999px;background:var(--primary,#0f172a);color:var(--primary-foreground,#f6f8fa);box-shadow:0 10px 15px -3px rgb(0 0 0/.1),0 4px 6px -4px rgb(0 0 0/.1);cursor:pointer;transition:transform .15s}.ds-fab:hover{transform:scale(1.05)}.ds-fab:active{transform:scale(.95)}.ds-fab:focus-visible{outline:2px solid var(--ring,#94a3b8);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Annotated Ledger",
    "overview": "Moni is a compact card dashboard. Each card states its finding in one plain Spanish sentence (\"Subiste +$20,1M desde fin de jun.\", \"Arriendo se lleva el 39% de lo que gastaste en el último mes\"), then shows the chart, list or sum that backs it up. The cards use the shadcn neutral style: white panels on an off-white ground with hairline borders, or near-black panels on a cool charcoal ground in dark mode. The theme follows the system preference and the app has no theme toggle.\n\nThe density is set by the owner. The dashboard replaced an Isotype layout that was rejected for being empty and wasting space, so every block takes only the room its content needs. Color carries meaning, not decoration. Four fixed domain colors (activos ochre, inversiones green, cartera blue, deudas red) are the only hues allowed, and they show up wherever those domains appear. Everything else is neutral. Sums are shown the way an adding machine would: entró, salió, a rule, then te quedó.\n\nArchivo sets every word and every number, with tabular figures across the whole document so amounts line up in columns. The app has no display face, no monospace and no decorative type.",
    "keyCharacteristics": [
      "One plain-language sentence at the top of every card, before any chart or list.",
      "Compact cards: 16px padding (20px from 640px), 12 to 16px gaps between cards.",
      "Four domain colors with fixed meanings; the rest is neutral.",
      "Archivo only, with tabular figures everywhere.",
      "Flat surfaces with hairline borders; shadows only on floating or selected elements.",
      "Light and dark themes follow `prefers-color-scheme`."
    ],
    "rules": [
      {
        "name": "The Four Meanings Rule",
        "body": "Activos is ochre, inversiones is green, cartera is blue, deudas is red, on every surface and in every chart. No fifth hue is ever introduced, and none of these colors is borrowed for decoration or for an unrelated meaning.",
        "section": "colors"
      },
      {
        "name": "The Text Variant Rule",
        "body": "Green and ochre each have a fill value and a text value. Any figure or word set in those colors uses the `-text` token. Blue and red are AA on both grounds as they are.",
        "section": "colors"
      },
      {
        "name": "The Neutral Spending Rule",
        "body": "Spending-by-category bars are drawn in Ink at 75%, not in a domain color. A category is not a domain, and red is kept for debt and outflow.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Archivo sets every word and number. Don't add a monospace for amounts or a display face for headings.",
        "section": "typography"
      },
      {
        "name": "The Weight Over Size Rule",
        "body": "Emphasis inside a sentence or list comes from weight (600) and domain color, not from larger type. Only the patrimonio figure is big.",
        "section": "typography"
      },
      {
        "name": "The Compact Rule",
        "body": "Nothing gets space it doesn't need. Cards are sized by their content, with no fixed heights beyond the chart itself (200px area, 120px bars), no hero padding and no empty decorative bands. If a block looks sparse, merge it or shrink it. Don't pad it.",
        "section": "layout"
      },
      {
        "name": "The Sentence First Rule",
        "body": "Every card opens with one plain-language sentence that interprets its numbers, such as \"Te quedó el 63,4% de lo que entró\" or \"Tenés 1 pago vencido y $1.145.000 por pagar en 45 días\". The chart, list or sum that follows is the evidence. A card that only shows numbers is unfinished.",
        "section": "layout"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Cards never get a shadow. Depth comes from the border and the change in surface color.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do open every card with one plain-language sentence that interprets its numbers, with the key figure semibold and colored by its sign.",
      "Do keep layouts compact: 16 to 20px card padding, 12 to 16px gaps, height set by content.",
      "Do show sums as an adding machine would: the items, a 2px Ink rule, then the total.",
      "Do use the `-text` variants for green and ochre whenever they color text.",
      "Do use a real minus sign (U+2212) and an explicit plus sign on signed amounts.",
      "Do keep the four domain colors bound to activos, inversiones, cartera and deudas everywhere."
    ],
    "donts": [
      "Don't add a fifth accent hue or use a domain color for decoration.",
      "Don't put shadows on cards; shadows are for floating and selected elements only.",
      "Don't introduce a second typeface, a monospace for amounts, or proportional figures.",
      "Don't add decorative empty space, hero bands or fixed-height cards that leave room unused.",
      "Don't show a card that is only numbers, with no sentence saying what they mean.",
      "Don't load fonts, icons or chart code from a CDN; everything is bundled or self-hosted."
    ]
  }
}