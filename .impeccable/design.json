  "components": [
    {
      "name": "Figure Row",
      "kind": "custom",
      "description": "Isotype row: identical flat pictograms on a 20-column grid, one figure per unit, half-figure remnant, colored by domain ink.",
      "html": "<div class=\"ds-fig\"><div class=\"ds-fig-label\"><div class=\"ds-fig-name\">Activos</div><div class=\"ds-fig-amt\">$287,0M</div><div class=\"ds-fig-det\">2 activos</div></div><div class=\"ds-fig-row\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg><span class=\"ds-fig-half\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2.5 1.5 11.5h3v10h5.5v-6.5h4v6.5h5.5v-10h3L12 2.5Z\"/></svg></span></div></div><p class=\"ds-fig-key\"><span class=\"ds-fig-sq\"></span>Una figura = $20M. Lo rojo resta.</p>",
      "css": "font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;.ds-fig{display:grid;grid-template-columns:11rem 1fr;gap:6px 24px;align-items:center;font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;} .ds-fig-name{font-size:15px;color:var(--ink,#1c1c1a)} .ds-fig-amt{font-size:15px;font-weight:600;color:var(--activos-text,#8a5f12);font-variant-numeric:tabular-nums} .ds-fig-det{font-size:13px;color:var(--ink-2,#5e5d58)} .ds-fig-row{display:grid;grid-template-columns:repeat(20,minmax(0,1fr));column-gap:3px;color:var(--activos,#d8a23a)} .ds-fig-row svg{width:100%;aspect-ratio:1} .ds-fig-half svg{clip-path:inset(0 50% 0 0)} .ds-fig-key{display:flex;align-items:center;gap:8px;margin-top:20px;font-size:13px;color:var(--ink-2,#5e5d58);font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;} .ds-fig-sq{width:11px;height:11px;background:var(--ink,#1c1c1a)}"
    },
    {
      "name": "Confirm Icon Button",
      "kind": "button",
      "refersTo": "button-confirm",
      "description": "Ink-filled square that registers an upcoming operation.",
      "html": "<button class=\"ds-btn-confirm\" aria-label=\"Registrar\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></button>",
      "css": ".ds-btn-confirm{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:3px;background:var(--ink,#1c1c1a);color:var(--paper,#fbfbf9);cursor:pointer;transition:opacity .15s} .ds-btn-confirm:hover{opacity:.85} .ds-btn-confirm:focus-visible{outline:2px solid var(--ink,#1c1c1a);outline-offset:2px}"
    },
    {
      "name": "Skip Icon Button",
      "kind": "button",
      "refersTo": "button-skip",
      "description": "Bare square that skips an upcoming operation; hover washes and turns red.",
      "html": "<button class=\"ds-btn-skip\" aria-label=\"No tomar esta vez\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button>",
      "css": ".ds-btn-skip{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:3px;background:transparent;color:var(--ink-2,#5e5d58);cursor:pointer;transition:background-color .15s,color .15s} .ds-btn-skip:hover{background:var(--wash,#f1f0eb);color:var(--deudas,#c3352b)} .ds-btn-skip:focus-visible{outline:2px solid var(--ink,#1c1c1a);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink fill, paper text; the only filled text action.",
      "html": "<button class=\"ds-btn-primary\">Guardar</button>",
      "css": ".ds-btn-primary{height:36px;padding:8px 16px;border:0;border-radius:3px;background:var(--ink,#1c1c1a);color:var(--paper,#fbfbf9);font-size:14px;font-weight:500;font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s} .ds-btn-primary:hover{background:color-mix(in srgb,var(--ink,#1c1c1a) 90%,transparent)} .ds-btn-primary:focus-visible{outline:2px solid var(--ink,#1c1c1a);outline-offset:2px}"
    },
    {
      "name": "Period Toggle",
      "kind": "chip",
      "refersTo": "toggle-period",
      "description": "Bare-text single-select; the active option gets a 2px ink underbar.",
      "html": "<div class=\"ds-tg\" role=\"group\" aria-label=\"Período\"><button class=\"ds-tg-i\">1S</button><button class=\"ds-tg-i\" aria-pressed=\"true\">1M</button><button class=\"ds-tg-i\">3M</button><button class=\"ds-tg-i\">1A</button><button class=\"ds-tg-i\">Todo</button></div>",
      "css": ".ds-tg{display:flex} .ds-tg-i{position:relative;height:32px;min-width:32px;padding:0 6px;border:0;background:transparent;color:var(--ink-2,#5e5d58);font-size:13px;font-weight:500;font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:color .15s} .ds-tg-i:hover{color:var(--ink,#1c1c1a)} .ds-tg-i::after{content:'';position:absolute;left:6px;right:6px;bottom:0;height:2px;background:transparent} .ds-tg-i[aria-pressed=true]{color:var(--ink,#1c1c1a)} .ds-tg-i[aria-pressed=true]::after{background:var(--ink,#1c1c1a)} .ds-tg-i:focus-visible{outline:2px solid var(--ink,#1c1c1a);outline-offset:2px}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "Text tabs on an ink header rule; active tab sits on a 3px ink bar. Alerta dot marks stale prices.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-nav-brand\">Moni</span><a class=\"ds-nav-t\" aria-current=\"page\" href=\"#\">Dashboard</a><a class=\"ds-nav-t\" href=\"#\">Deudas</a><a class=\"ds-nav-t\" href=\"#\">Inversiones<span class=\"ds-nav-dot\"></span></a><a class=\"ds-nav-t\" href=\"#\">Ajustes</a></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:4px;height:56px;padding:0 32px;border-bottom:1px solid var(--ink,#1c1c1a);background:var(--paper,#fbfbf9);font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;} .ds-nav-brand{align-self:center;margin-right:auto;font-size:19px;font-weight:600;letter-spacing:-0.025em;color:var(--ink,#1c1c1a)} .ds-nav-t{display:flex;align-items:center;margin-bottom:-1px;padding:0 12px;border-bottom:3px solid transparent;font-size:15px;color:var(--ink-2,#5e5d58);text-decoration:none;transition:color .15s} .ds-nav-t:hover{color:var(--ink,#1c1c1a)} .ds-nav-t[aria-current=page]{border-bottom-color:var(--ink,#1c1c1a);color:var(--ink,#1c1c1a);font-weight:500} .ds-nav-t:focus-visible{outline:2px solid var(--ink,#1c1c1a);outline-offset:2px} .ds-nav-dot{display:inline-block;width:6px;height:6px;margin-left:6px;border-radius:9999px;background:var(--alerta,#b06d00);transform:translateY(-8px)}"
    },
    {
      "name": "Section Header",
      "kind": "card",
      "description": "The replacement for cards: ink rule, 18px semibold title, toggles to the right.",
      "html": "<section class=\"ds-sec\"><div class=\"ds-sec-h\"><h2>Lo que viene</h2><span class=\"ds-sec-x\">1M</span></div><p class=\"ds-sec-p\"><b>$2.978.000</b> en gastos, incluidas las tarjetas.</p></section>",
      "css": ".ds-sec{border-top:1px solid var(--ink,#1c1c1a);padding-top:16px;font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;} .ds-sec-h{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 24px;margin-bottom:20px} .ds-sec-h h2{margin:0;font-size:18px;font-weight:600;letter-spacing:-0.025em;color:var(--ink,#1c1c1a)} .ds-sec-x{font-size:13px;color:var(--ink-2,#5e5d58)} .ds-sec-p{margin:0;font-size:15px;color:var(--ink-2,#5e5d58)} .ds-sec-p b{font-weight:600;color:var(--ink,#1c1c1a)}"
    },
    {
      "name": "Upcoming Operation Row",
      "kind": "custom",
      "description": "Date column (large day, small uppercase month), label and subline, domain-ink amount, skip and confirm.",
      "html": "<div class=\"ds-op\"><div class=\"ds-op-d\"><div class=\"ds-op-n\">10</div><div class=\"ds-op-m\">nov</div></div><div class=\"ds-op-b\"><div class=\"ds-op-l\">Préstamo familiar</div><div class=\"ds-op-s\">Cuota deuda · <span>vencido 3d</span></div></div><div class=\"ds-op-a\">−$250.000</div><button class=\"ds-op-x\" aria-label=\"No tomar\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button><button class=\"ds-op-c\" aria-label=\"Registrar\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></button></div>",
      "css": ".ds-op{display:flex;align-items:center;gap:16px;padding:12px 0;border-bottom:1px solid var(--rule,#dedcd5);font-family:'Jost Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-op-d{width:44px;text-align:center;line-height:1} .ds-op-n{font-size:26px;font-weight:500;letter-spacing:-0.025em;color:var(--deudas,#c3352b)} .ds-op-m{margin-top:4px;font-size:11px;font-weight:500;letter-spacing:.025em;text-transform:uppercase;color:var(--ink-2,#5e5d58)} .ds-op-b{flex:1;min-width:0} .ds-op-l{font-size:15px;color:var(--ink,#1c1c1a)} .ds-op-s{font-size:13px;color:var(--ink-2,#5e5d58)} .ds-op-s span{font-weight:500;color:var(--deudas,#c3352b)} .ds-op-a{font-size:15px;font-weight:600;color:var(--deudas,#c3352b)} .ds-op-x,.ds-op-c{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:3px;cursor:pointer} .ds-op-x{background:transparent;color:var(--ink-2,#5e5d58)} .ds-op-x:hover{background:var(--wash,#f1f0eb);color:var(--deudas,#c3352b)} .ds-op-c{background:var(--ink,#1c1c1a);color:var(--paper,#fbfbf9)} .ds-op-c:hover{opacity:.85} .ds-op-x:focus-visible,.ds-op-c:focus-visible{outline:2px solid var(--ink,#1c1c1a);outline-offset:2px}"
    }
