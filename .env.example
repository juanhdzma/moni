# Owner password hash. Generate it with: python -m backend.seguridad hash
# Keep it in single quotes: it contains "$" and Compose would interpolate it.
# Without it nobody can sign in: every /api/* route answers 401.
MONI_PASSWORD_HASH=

# WebAuthn (passkeys, Face ID). For local use: localhost and http://localhost:8080
MONI_RP_ID=moni.nufi.com.co
MONI_ORIGIN=https://moni.nufi.com.co

# Trusted reverse proxies (CIDRs, comma separated): the only sources of X-Forwarded-For/Proto.
# Use the exact proxy address, never a whole private range. Details in docs/DEPLOYMENT.md#configuration.
MONI_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Hours an IP stays blocked after 3 failed logins within an hour
MONI_BLOCK_HOURS=24

# Optional bearer token (32+ characters) for POST /api/push/enviar without a session.
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONI_PUSH_TOKEN=

VAPID_SUBJECT=https://moni.nufi.com.co
