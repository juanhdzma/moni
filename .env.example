# Hash de la clave del dueño. Generalo con: python -m backend.auth hash
# Va entre comillas simples porque contiene "$" (Compose lo interpolaria).
# Sin este valor nadie puede entrar: todo /api/* responde 401.
MONI_PASSWORD_HASH=

# WebAuthn (Face ID). Para local: localhost y http://localhost:8080
MONI_RP_ID=moni.nufi.com.co
MONI_ORIGIN=https://moni.nufi.com.co

# Proxies inversos de confianza (CIDR, separados por coma). Solo desde ellos se lee X-Forwarded-For y X-Forwarded-Proto.
# Poné el CIDR exacto del reverse proxy (ej. 172.18.0.5/32). No uses rangos privados enteros:
# cualquier equipo de la LAN podria falsear su IP y evadir el bloqueo.
# Si el proxy no esta listado, todos los usuarios comparten su IP (3 fallos bloquean a todos),
# la cookie no se marca Secure y no se envia HSTS.
MONI_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Horas de bloqueo tras 3 fallos de la misma IP en 1 hora
MONI_BLOCK_HOURS=24

# Token para POST /api/push/enviar sin sesion (opcional, minimo 32 caracteres).
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONI_PUSH_TOKEN=

VAPID_SUBJECT=https://moni.nufi.com.co
